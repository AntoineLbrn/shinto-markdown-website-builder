---
import "leaflet/dist/leaflet.css";
export interface Props {
    points?: Array<{ name: string; lat: number; lng: number }>;
}
const { points = [] } = Astro.props;
---

<div id="map" style="height: 400px;" data-points={JSON.stringify(points)}></div>

<script is:inline client:load>
    // charge Leaflet côté navigateur uniquement
    const script = document.createElement("script");
    script.src = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.js";
    script.onload = () => {
        const map = L.map("map").setView([48.8566, 2.3522], 4);
        L.tileLayer("https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png", {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
            maxZoom: 19
        }).addTo(map);

        const pointsData = document
            .getElementById("map")
            .getAttribute("data-points");
        const points = pointsData ? JSON.parse(pointsData) : [];
        
        points.forEach(({ name, lat, lng }) => {
            L.marker([lat, lng]).addTo(map).bindPopup(name);
        });
        
        // Fit map to show all points, or use default center if no points
        if (points.length > 0) {
            const bounds = L.latLngBounds(points.map(p => [p.lat, p.lng]));
            map.fitBounds(bounds, { padding: [50, 50] });
        }
        
        console.log("Map initialized:", map);
        console.log("Points to add:", points);
    };
    document.head.appendChild(script);
</script>
